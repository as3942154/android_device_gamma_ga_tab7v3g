/misc            emmc    /dev/misc
/boot            emmc    /dev/bootimg
/recovery        emmc    /dev/recovery

/system          ext4    /dev/block/mmcblk0p6    flags=display="system"
/cache           ext4    /dev/block/mmcblk0p2    flags=display="cache"
/data            ext4    /dev/block/mmcblk0p3    flags=display="data"

/sdcard          vfat    /dev/block/mmcblk0p4    flags=display="Internal SD Card"
/external_sd     vfat    /dev/block/mmcblk1p1   /dev/block/mmcblk1    flags=display="Micro SD Card";storage;removable

/nvram           emmc    /dev/nvram              flags=display="nvram";backup=1
/uboot           emmc    /dev/uboot              flags=display="uboot";backup=1
/logo            emmc    /dev/logo               flags=display="logo";backup=1
